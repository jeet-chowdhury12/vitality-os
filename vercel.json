{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/patient-portal-app/:path*",
      "destination": "/patient-portal-app/index.html"
    },
    {
      "source": "/patient-portal-app",
      "destination": "/patient-portal-app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
